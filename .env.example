# 复制为 .env 后按需修改：cp .env.example .env

# 对外监听端口
XPRA_PORT=14500

# 监听地址：0.0.0.0 = 局域网内任何电脑都能访问；127.0.0.1 = 仅本机
XPRA_BIND=0.0.0.0

# 访问密码。留空则首次启动自动生成，可用 `make password` 查看
XPRA_PASSWORD=

# 容器时区
TZ=Asia/Shanghai

# 传给 Claude Desktop 的额外参数，例如 --no-sandbox
CLAUDE_ARGS=

# 固定 Claude Desktop 版本（如 4.23118.0），留空表示最新版
CLAUDE_DESKTOP_VERSION=

# 1 = 使用 GPU（需要 NVIDIA 驱动与 nvidia container toolkit）
CLAUDE_GPU=0

# 是否安装中日韩字体
INSTALL_CJK_FONTS=true

# 是否安装容器内浏览器。OAuth 登录需要，设为 false 会省下约 250 MB，
# 但之后只能先别处登录再挂载 ~/.config/Claude
INSTALL_BROWSER=true
