# 复制为 .env 后按需修改：cp .env.example .env

# 对外监听端口
XPRA_PORT=14500

# 监听地址：0.0.0.0 = 局域网内任何电脑都能访问；127.0.0.1 = 仅本机
XPRA_BIND=0.0.0.0

# 访问密码。留空则首次启动自动生成，可用 `make password` 查看
XPRA_PASSWORD=

# 容器时区
TZ=Asia/Shanghai

# 传给 Claude Desktop 的额外参数，例如 --no-sandbox
CLAUDE_ARGS=

# 固定 Claude Desktop 版本（如 4.23118.0），留空表示最新版
CLAUDE_DESKTOP_VERSION=

# 1 = 使用 GPU（需要 NVIDIA 驱动与 nvidia container toolkit）
CLAUDE_GPU=0

# 是否安装中日韩字体
INSTALL_CJK_FONTS=true

# 是否安装容器内浏览器。OAuth 登录需要，设为 false 会省下约 250 MB，
# 但之后只能先别处登录再挂载 ~/.config/Claude
INSTALL_BROWSER=true

# 是否安装 Clash Verge Rev（容器内代理客户端，窗口同样经 Xpra 转发）
INSTALL_CLASH_VERGE=true
CLASH_VERGE_VERSION=2.5.10

# 启动时是否拉起 Clash Verge 窗口（1/0）
ENABLE_CLASH_VERGE=1

# 是否让 Claude Desktop 走容器内的 Clash（1/0）
# 设为 1 时 Claude 会带上 http_proxy/https_proxy 指向 Clash 的混合端口。
# 还没配好订阅时 Claude 会连不上网，这是预期行为。
ENABLE_PROXY=1

# 代理地址。留空则自动读取 Clash Verge 配置里的 verge_mixed_port，
# 读不到就用 http://127.0.0.1:7897
PROXY_URL=

# 强制指定 Clash 混合端口（留空则自动探测）
CLASH_MIXED_PORT=
